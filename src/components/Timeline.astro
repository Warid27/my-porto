---
import timeline from '../../data/timeline.json';
---
<section id="timeline" class="py-[clamp(4rem,8vw,8rem)] bg-[var(--bg-base)]" style="border-top: 1px solid var(--border);">
  <div class="max-w-[1200px] mx-auto px-[clamp(1.5rem,5vw,5rem)]">
    <div class="text-center mb-16" data-aos="fade-up">
      <span class="jp-label">{timeline.sectionLabel}</span>
      <h2 class="jp-heading" style="font-size: clamp(2rem, 4vw, 2.5rem);">{timeline.heading}</h2>
    </div>

    <div class="relative">
      <div class="timeline-connector hidden lg:block"></div>

      {timeline.entries.map(entry => (
        <div class={`relative flex flex-col lg:flex-row items-center ${entry !== timeline.entries[timeline.entries.length - 1] ? 'mb-12' : ''}`} data-aos={entry.side === 'left' ? 'fade-right' : 'fade-left'}>
          {entry.side === 'left' && <div class="hidden lg:block w-1/2"></div>}
          {entry.side === 'right' && (
            <div class="lg:w-1/2 lg:pr-12 w-full">
              <div class="jp-card p-6">
                <span class="jp-label mb-2">{entry.label}</span>
                <div class="flex items-center gap-3 mb-2">
                  <span class="font-body font-normal text-sm" style={`color: ${entry.accent};`}>{entry.year}</span>
                  <h3 class="font-body font-medium text-base text-[var(--text-primary)]">{entry.title}</h3>
                </div>
                <p class="font-body font-normal text-sm text-[var(--text-secondary)] mb-2">{entry.role}</p>
                <p class="font-body font-light text-[13px] text-[var(--text-muted)] leading-relaxed">{entry.description}</p>
              </div>
            </div>
          )}
          <div class="hidden lg:block timeline-dot"></div>
          {entry.side === 'left' && (
            <div class="lg:w-1/2 lg:pl-12 w-full">
              <div class="jp-card p-6">
                <span class="jp-label mb-2">{entry.label}</span>
                <div class="flex items-center gap-3 mb-2">
                  <span class="font-body font-normal text-sm" style={`color: ${entry.accent};`}>{entry.year}</span>
                  <h3 class="font-body font-medium text-base text-[var(--text-primary)]">{entry.title}</h3>
                </div>
                <p class="font-body font-normal text-sm text-[var(--text-secondary)] mb-2">{entry.role}</p>
                <p class="font-body font-light text-[13px] text-[var(--text-muted)] leading-relaxed">{entry.description}</p>
              </div>
            </div>
          )}
          {entry.side === 'right' && <div class="hidden lg:block w-1/2"></div>}
        </div>
      ))}
    </div>
  </div>
</section>