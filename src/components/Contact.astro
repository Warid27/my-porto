---
import { Icon } from 'astro-icon/components';
import site from '../../data/site.json';
import contact from '../../data/contact.json';

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || "";
const HAS_TURNSTILE = TURNSTILE_SITE_KEY && TURNSTILE_SITE_KEY !== "";
---

<section id="contact" class="py-[clamp(4rem,8vw,8rem)] bg-[var(--bg-card)]">
  <div class="max-w-[1200px] mx-auto px-[clamp(1.5rem,5vw,5rem)]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
      <div data-aos="fade-right">
        <span class="jp-label">{contact.sectionLabel}</span>
        <h2 class="jp-heading mb-4" style="font-size: clamp(2rem, 3.5vw, 2.25rem);">{contact.heading}</h2>
        <p class="font-body font-light text-[15px] text-[var(--text-secondary)] mb-8 leading-relaxed">{contact.body}</p>
        
        <div class="space-y-3 mb-6">
          {site.social.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" class="jp-card p-4 flex items-center gap-4 no-underline group">
              <Icon name={link.icon} aria-hidden="true" class="w-5 h-5 text-[var(--text-secondary)] group-hover:text-[var(--accent-sakura)] transition-colors" />
              <span class="font-body font-normal text-sm text-[var(--text-primary)]">{link.platform}</span>
              <span class="font-body font-light text-sm text-[var(--text-secondary)]">{link.handle}</span>
              <span aria-hidden="true" class="ml-auto font-body text-[var(--text-secondary)] group-hover:text-[var(--accent-sakura)] transition-colors">→</span>
            </a>
          ))}
        </div>
        <a href={`mailto:${contact.email}`} class="font-body font-light text-sm text-[var(--text-secondary)] hover:text-[var(--accent-sakura)] transition-colors">{contact.email}</a>
      </div>

      <div data-aos="fade-left">
        <div class="jp-card p-8 bg-[var(--bg-base)]">
          <h3 class="font-body font-medium text-lg text-[var(--text-primary)] mb-6">{contact.form.title}</h3>
          
          <form id="contact-form" class="flex flex-col gap-5">
            <input type="hidden" name="subject" value="New Submission from Portfolio">
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off">

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {contact.form.fields.filter(f => f.halfWidth).map(field => (
                <div>
                  <label class="jp-label" for={field.id}>{field.label}</label>
                  <input type={field.type} id={field.id} name={field.id} class="jp-input" placeholder={field.placeholder} required autocomplete={field.type === 'email' ? 'email' : field.id === 'name' ? 'name' : undefined} />
                </div>
              ))}
            </div>

            {contact.form.fields.filter(f => !f.halfWidth && f.type !== 'textarea').map(field => (
              <div>
                <label class="jp-label" for={field.id}>{field.label}</label>
                <input type={field.type} id={field.id} name={field.id} class="jp-input" placeholder={field.placeholder} required />
              </div>
            ))}

            {contact.form.fields.filter(f => f.type === 'textarea').map(field => (
              <div>
                <label class="jp-label" for={field.id}>{field.label}</label>
                <textarea id={field.id} name={field.id} rows={field.rows || 4} class="jp-input resize-none" placeholder={field.placeholder} required minlength="10"></textarea>
              </div>
            ))}

            {HAS_TURNSTILE && (
              <div id="turnstile-wrapper" class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="light" data-size="normal" data-action="contact-submit"></div>
            )}

            <p id="form-status" class="font-body text-sm hidden"></p>
            <button type="submit" id="contact-submit-btn" class="jp-btn-primary w-full justify-center">{contact.form.buttonLabel}</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

{HAS_TURNSTILE && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status') as HTMLParagraphElement | null;
  const button = document.getElementById('contact-submit-btn') as HTMLButtonElement | null;

  function setStatus(message: string, isError: boolean) {
    if (!status) return;
    status.classList.remove('hidden', 'text-green-600', 'text-red-500');
    status.classList.add(isError ? 'text-red-500' : 'text-green-600');
    status.textContent = message;
  }

  function resetTurnstile() {
    if (typeof window !== 'undefined' && (window as any).turnstile) {
      const wrappers = document.querySelectorAll('.cf-turnstile');
      wrappers.forEach((w) => {
        try { (window as any).turnstile.reset(w); } catch {}
      });
    }
  }

  function getTurnstileToken(): string {
    if (typeof window === 'undefined' || !(window as any).turnstile) return "";
    const wrappers = document.querySelectorAll<HTMLElement>('.cf-turnstile');
    for (const w of Array.from(wrappers)) {
      try {
        const tok = (window as any).turnstile.getResponse(w);
        if (tok && tok !== "") return tok;
      } catch {}
    }
    const input = document.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
    return input?.value || "";
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!status) return;

      const origLabel = button?.textContent || "Send it →";
      if (button) {
        button.textContent = "Sending...";
        button.setAttribute('disabled', 'true');
      }

      try {
        const formData = new FormData(form);
        const tt = getTurnstileToken();
        if (tt !== "") formData.set("cf-turnstile-response", tt);

        const response = await fetch('/api/contact', {
          method: 'POST',
          body: formData,
        });

        let data: any = {};
        try {
          data = await response.json();
        } catch {
          data.message = response.statusText || "Unexpected error";
        }

        if (response.status === 200 && data.success) {
          setStatus(data.message || "Message sent successfully! I'll get back to you soon. 👋", false);
          form.reset();
          resetTurnstile();
        } else if (response.status === 429) {
          setStatus(data.message || "Too many requests. Please wait a few minutes and try again.", true);
          resetTurnstile();
        } else {
          setStatus(data.message || "Something went wrong. Please try again.", true);
          resetTurnstile();
        }
      } catch (error) {
        setStatus("Network error. Please try again, or email me directly at the address on the left.", true);
        resetTurnstile();
      } finally {
        if (button) {
          button.textContent = origLabel;
          button.removeAttribute('disabled');
        }
      }
    });
  }
</script>
