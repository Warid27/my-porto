---
---
<section id="home" class="min-h-screen flex items-center bg-[var(--white)] pt-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <!-- Two-column grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
      <!-- LEFT COLUMN -->
      <div data-aos="fade-right">
        <span class="nb-section-label nb-rotate-badge">[ AVAILABLE FOR WORK ]</span>
        <h1 class="font-display font-extrabold leading-[1.05] mb-4" style="font-size: clamp(52px, 8vw, 92px);">
          Sinatrya<br />
          Al <span class="nb-underline">Warid.</span>
        </h1>
        <p class="text-lg text-gray-600 mb-3 font-display">Ambitious student developer · Full-stack & Game dev · Magelang, Indonesia</p>
        <p class="text-[15px] text-gray-700 mb-6 leading-relaxed">I build web apps, games, and digital experiences that actually work. Currently at SMKN 2 Magelang and Reka Solusi Teknologi — learning in public, shipping in private.</p>
        <div class="flex flex-wrap gap-3 mb-8">
          <a href="#projects" class="nb-btn px-6 py-3 text-black no-underline" style="background: var(--yellow);">View Projects ↓</a>
          <a href="https://github.com/Warid27" target="_blank" rel="noopener" class="nb-btn px-6 py-3 text-black no-underline bg-[var(--white)]">GitHub ↗</a>
        </div>
        <!-- Stat row -->
        <div class="flex flex-wrap gap-4">
          <div class="px-4 py-3 text-center" style="background: var(--yellow); border: 3px solid var(--black); box-shadow: 4px 4px 0 var(--black);">
            <div class="font-display font-extrabold text-2xl">6+</div>
            <div class="font-mono text-[11px] font-bold uppercase tracking-wider mt-1">Years coding</div>
          </div>
          <div class="px-4 py-3 text-center" style="background: var(--yellow); border: 3px solid var(--black); box-shadow: 4px 4px 0 var(--black);">
            <div class="font-display font-extrabold text-2xl">10+</div>
            <div class="font-mono text-[11px] font-bold uppercase tracking-wider mt-1">Projects shipped</div>
          </div>
          <div class="px-4 py-3 text-center" style="background: var(--yellow); border: 3px solid var(--black); box-shadow: 4px 4px 0 var(--black);">
            <div class="font-display font-extrabold text-2xl">5+</div>
            <div class="font-mono text-[11px] font-bold uppercase tracking-wider mt-1">Tech stacks</div>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN -->
      <div class="flex flex-col items-center lg:items-center" data-aos="fade-left">
        <div class="nb-avatar">AW</div>
        <div class="nb-card bg-[var(--white)] mt-4 p-4 w-full max-w-[280px]">
          <p class="font-mono text-sm font-bold mb-1">
            <span style="color: var(--green); animation: pulse 2s ease infinite; display: inline-block;">●</span> Currently working at
          </p>
          <p class="font-display font-bold text-lg">Reka Solusi Teknologi</p>
          <p class="font-mono text-xs text-gray-500 mt-1">📍 Magelang, Indonesia</p>
        </div>
        <span class="nb-tag mt-4" style="background:var(--yellow)">SMKN 2 MAGELANG · PPLG</span>
      </div>
    </div>

    <!-- Marquee ticker -->
    <div class="marquee-wrapper mt-12 -mx-4 sm:-mx-6 lg:-mx-8" style="background: var(--black); border-top: 3px solid var(--black); border-bottom: 3px solid var(--black);">
      <div class="marquee-track py-3">
        <span class="font-mono font-bold uppercase text-[14px] whitespace-nowrap" style="color: var(--yellow);">
          Next.js &nbsp;·&nbsp; React &nbsp;·&nbsp; Vue &nbsp;·&nbsp; Flutter &nbsp;·&nbsp; Three.js &nbsp;·&nbsp; Laravel &nbsp;·&nbsp; Node.js &nbsp;·&nbsp; Astro &nbsp;·&nbsp; Docker &nbsp;·&nbsp; PostgreSQL &nbsp;·&nbsp; Cloudflare &nbsp;·&nbsp; TypeScript &nbsp;·
        </span>
        <span class="font-mono font-bold uppercase text-[14px] whitespace-nowrap" style="color: var(--yellow);">
          Next.js &nbsp;·&nbsp; React &nbsp;·&nbsp; Vue &nbsp;·&nbsp; Flutter &nbsp;·&nbsp; Three.js &nbsp;·&nbsp; Laravel &nbsp;·&nbsp; Node.js &nbsp;·&nbsp; Astro &nbsp;·&nbsp; Docker &nbsp;·&nbsp; PostgreSQL &nbsp;·&nbsp; Cloudflare &nbsp;·&nbsp; TypeScript &nbsp;·
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }
</style>