---
import { Icon } from 'astro-icon/components';
---
<footer style="background: var(--black); border-top: 3px solid var(--yellow);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Top row -->
    <div class="flex flex-col md:flex-row items-center justify-between py-6 gap-4" style="border-bottom: 1px solid #333;">
      <!-- Logo -->
      <span class="font-mono font-bold text-[var(--yellow)] px-3 py-1" style="border: 3px solid var(--yellow); box-shadow: 3px 3px 0 var(--yellow);">[ AW ]</span>

      <!-- Center text -->
      <p class="font-mono text-[13px] text-center" style="color: #888;">Designed & built with too much espresso in Magelang, Indonesia.</p>

      <!-- Social icons -->
      <div class="flex gap-2">
        <a href="https://github.com/Warid27" target="_blank" rel="noopener" class="nb-btn px-2 py-2 bg-transparent text-white border-white" style="box-shadow: 2px 2px 0 var(--yellow);">
          <Icon name="simple-icons:github" class="w-5 h-5" />
        </a>
        <a href="https://www.instagram.com/sinatrya_al_warid/" target="_blank" rel="noopener" class="nb-btn px-2 py-2 bg-transparent text-white border-white" style="box-shadow: 2px 2px 0 var(--yellow);">
          <Icon name="simple-icons:instagram" class="w-5 h-5" />
        </a>
        <a href="https://www.facebook.com/Sinatrya" target="_blank" rel="noopener" class="nb-btn px-2 py-2 bg-transparent text-white border-white" style="box-shadow: 2px 2px 0 var(--yellow);">
          <Icon name="simple-icons:facebook" class="w-5 h-5" />
        </a>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row items-center justify-between py-4 gap-2">
      <p class="font-mono text-xs" style="color: #666;">&copy; 2025 Sinatrya Al Warid</p>
      <a href="https://al-warid.web.id" class="font-mono text-xs no-underline" style="color: var(--yellow);">al-warid.web.id</a>
    </div>

    <!-- Easter egg -->
    <p class="font-mono text-[11px] text-center pb-4" style="color: #444;">/* This site will not be held responsible for any existential crises caused by actually understanding your legacy codebase. */</p>
  </div>
</footer>