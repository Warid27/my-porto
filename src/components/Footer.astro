---
import { Icon } from 'astro-icon/components';
---
<footer style="background: var(--bg-dark); border-top: 1px solid rgba(245,239,230,0.12);">
  <div class="max-w-[1200px] mx-auto px-[clamp(1.5rem,5vw,5rem)] py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start">
      <!-- Left — Logo + social -->
      <div class="flex flex-col items-start gap-4">
        <span class="font-display font-semibold text-2xl text-white tracking-tight">
          sinatrya<span style="color: var(--accent-sakura);">.</span>
        </span>
        <p class="font-body font-light text-[13px] text-[var(--text-muted)] leading-relaxed">Designed & built with too much espresso in Magelang, Indonesia.</p>
        <div class="flex gap-3 mt-1">
          <a href="https://github.com/Warid27" target="_blank" rel="noopener" class="flex items-center justify-center w-9 h-9 rounded-full border border-[var(--text-muted)] bg-transparent text-[var(--text-muted)] no-underline transition-all hover:border-white hover:text-white" style="opacity: 0.7;">
            <Icon name="lucide:github" class="w-4 h-4" />
          </a>
          <a href="https://www.instagram.com/sinatrya_al_warid/" target="_blank" rel="noopener" class="flex items-center justify-center w-9 h-9 rounded-full border border-[var(--text-muted)] bg-transparent text-[var(--text-muted)] no-underline transition-all hover:border-white hover:text-white" style="opacity: 0.7;">
            <Icon name="lucide:instagram" class="w-4 h-4" />
          </a>
          <a href="https://www.facebook.com/Sinatrya" target="_blank" rel="noopener" class="flex items-center justify-center w-9 h-9 rounded-full border border-[var(--text-muted)] bg-transparent text-[var(--text-muted)] no-underline transition-all hover:border-white hover:text-white" style="opacity: 0.7;">
            <Icon name="lucide:facebook" class="w-4 h-4" />
          </a>
        </div>
      </div>

      <!-- Center — Nav links -->
      <div class="flex flex-col gap-3 md:items-center">
        <a href="#about" class="font-body font-light text-sm text-[var(--text-muted)] no-underline hover:text-white transition-colors">About</a>
        <a href="#skills" class="font-body font-light text-sm text-[var(--text-muted)] no-underline hover:text-white transition-colors">Skills</a>
        <a href="#projects" class="font-body font-light text-sm text-[var(--text-muted)] no-underline hover:text-white transition-colors">Projects</a>
        <a href="#contact" class="font-body font-light text-sm text-[var(--text-muted)] no-underline hover:text-white transition-colors">Contact</a>
      </div>

      <!-- Right — CTA -->
      <div class="flex flex-col items-start md:items-end gap-4">
        <a href="#contact" class="jp-btn-primary text-sm" style="background: var(--accent-sakura); color: var(--bg-dark);">Get in touch →</a>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="flex flex-col sm:flex-row items-center justify-between pt-8 mt-8 gap-3" style="border-top: 1px solid rgba(245,239,230,0.08);">
      <p class="font-body font-light text-xs text-[var(--text-muted)]">&copy; 2025 Sinatrya Al Warid. All rights reserved.</p>
      <a href="https://al-warid.web.id" class="font-body font-light text-xs text-[var(--text-muted)] no-underline hover:text-white transition-colors">al-warid.web.id</a>
    </div>

    <!-- Easter egg -->
    <p class="font-body font-light text-[11px] text-center mt-6" style="color: rgba(245,239,230,0.15);">/* Built with intention, a quiet evening, and just enough caffeine. */</p>
  </div>
</footer>