---
import { Icon } from 'astro-icon/components';
import site from '../../data/site.json';
import contact from '../../data/contact.json';

const github = site.social.find(link => link.platform === 'GitHub');
const presence = [
  ...(github ? [{ label: 'GitHub', href: github.url, icon: github.icon, external: true }] : []),
  { label: 'Email', href: `mailto:${contact.email}`, icon: 'lucide:mail', external: false },
];
---
<footer class="jp-footer" style="background: #E8E0D5; border-top: 1px solid #E0D8CC;">
  <div class="max-w-[1200px] mx-auto px-[clamp(1.5rem,5vw,5rem)] py-[clamp(3.5rem,7vw,5rem)]">
    <div class="flex flex-col md:flex-row items-center justify-between gap-7 md:gap-12">

      <!-- Copyright -->
      <p class="font-body font-light text-[13px] tracking-[0.08em] text-[#6B645C] m-0 whitespace-nowrap">
        {site.footer.copyright}
      </p>

      <!-- Navigation -->
      <nav aria-label="Footer navigation" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        {site.footer.nav.map((link, i) => (
          <>
            {i > 0 && <span aria-hidden="true" class="font-body text-sm text-[#B3A99B] select-none">·</span>}
            <a
              href={link.href}
              class="font-body font-light text-sm text-[#6B645C] no-underline transition-colors duration-300 hover:text-[#8F6A4F]"
            >
              {link.label}
            </a>
          </>
        ))}
      </nav>

      <!-- Presence -->
      <div class="flex items-center gap-6">
        {presence.map(item => (
          <a
            href={item.href}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            aria-label={item.label}
            class="flex items-center justify-center text-[#6B645C] no-underline transition-colors duration-300 hover:text-[#8F6A4F]"
          >
            <Icon name={item.icon} class="w-[18px] h-[18px]" />
          </a>
        ))}
      </div>

    </div>
  </div>
</footer>
