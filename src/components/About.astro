---
import about from '../../data/about.json';
---
<section id="about" class="py-[clamp(4rem,8vw,8rem)] bg-[var(--bg-base)]">
  <div class="max-w-[1200px] mx-auto px-[clamp(1.5rem,5vw,5rem)]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- LEFT — Giant display quote -->
      <div data-aos="fade-right">
        <h2 class="font-display font-light leading-[1.15] text-[var(--text-primary)]" style="font-size: clamp(2.5rem, 5vw, 3.5rem);">
          {about.quote.line1}<br />
          {about.quote.line2}<br />
          <span style="color: var(--accent-sakura);">{about.quote.line3}</span>
        </h2>
      </div>

      <!-- RIGHT — Text content -->
      <div data-aos="fade-left">
        <span class="jp-label">{about.sectionLabel}</span>
        {about.paragraphs.map((p, i) => (
          <>
            <p class="font-body font-light text-[15px] text-[var(--text-secondary)] leading-relaxed mb-6">{p}</p>
            {i < about.paragraphs.length - 1 && <div style="border-bottom: 1px solid var(--border); margin-bottom: 1.5rem;"></div>}
          </>
        ))}

        <!-- Info cards row -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-6">
          {about.infoCards.map(card => (
            <div class={`jp-card p-4${card.span ? ' sm:col-span-2' : ''}`}>
              <p class="font-body font-normal text-[11px] uppercase tracking-[0.08em] text-[var(--text-muted)] mb-1">{card.icon} {card.label}</p>
              <p class="font-body font-normal text-sm text-[var(--text-primary)]">{card.value}</p>
            </div>
          ))}
        </div>

        <!-- Interest badges -->
        <div class="flex flex-wrap gap-2">
          {about.interestBadges.map(badge => (
            <span class="jp-tag">{badge}</span>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>