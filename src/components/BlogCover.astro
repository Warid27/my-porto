---
// Cover gambar untuk blog — dipakai di kartu index & hero post.
// Kalau post tidak punya gambar (atau url-nya kosong), render placeholder
// SVG japandi inline: tanpa CDN eksternal, tanpa request jaringan.
interface BlogImage {
  url: string;
  alt?: string;
  caption?: string;
}

interface Props {
  image?: BlogImage;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { image, loading = 'lazy', class: className, ...rest } = Astro.props;

// ID unik per instance — blog index me-render beberapa cover di satu halaman,
// jadi id <defs> tidak boleh duplikat.
const leafId = `jp-leaf-${Math.random().toString(36).slice(2, 8)}`;
---
<figure class:list={['blog-cover', className]} {...rest}>
  {image?.url ? (
    <img src={image.url} alt={image.alt ?? ''} loading={loading} decoding="async" />
  ) : (
    <svg
      class="blog-cover-art"
      viewBox="0 0 1600 900"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
    >
      <!-- Langit & tanah -->
      <rect width="1600" height="900" fill="#EFE9E0" />
      <rect y="648" width="1600" height="252" fill="#E8E0D5" />

      <!-- Enso — kuas lingkaran yang tidak menutup sempurna -->
      <circle
        cx="820"
        cy="405"
        r="235"
        fill="none"
        stroke="#C4B9A9"
        stroke-width="13"
        stroke-linecap="round"
        stroke-dasharray="1300 176.5"
        transform="rotate(115 820 405)"
      />

      <!-- Ranting yang menembus enso -->
      <path
        d="M540 618 C 700 545, 890 470, 1085 418"
        fill="none"
        stroke="#A89F94"
        stroke-width="7"
        stroke-linecap="round"
      />
      <circle cx="1085" cy="418" r="9" fill="#8B9E7E" opacity="0.9" />

      <!-- Daun — bentuk lanset runcing, urat daun jelas, hijau sage lembut -->
      <defs>
        <g id={leafId}>
          <path
            d="M 0 0 C -9 -16, -31 -38, -33 -70 C -35 -102, -17 -121, 0 -132 C 17 -121, 35 -102, 33 -70 C 31 -38, 9 -16, 0 0 Z"
            fill="#8B9E7E"
          />
          <path
            d="M 0 -6 C 1 -46, 1 -88, 0 -127"
            fill="none" stroke="#EFE9E0" stroke-width="3" stroke-linecap="round" opacity="0.55"
          />
          <path
            d="M 0 -48 Q -10 -52, -16 -63 M 0 -48 Q 10 -52, 16 -63 M 0 -84 Q -8 -88, -12 -97 M 0 -84 Q 8 -88, 12 -97"
            fill="none" stroke="#EFE9E0" stroke-width="2" stroke-linecap="round" opacity="0.45"
          />
        </g>
      </defs>
      <use href={`#${leafId}`} transform="translate(665 563) rotate(-55) scale(1.15)" opacity="0.95" />
      <use href={`#${leafId}`} transform="translate(799 510) rotate(50)" opacity="0.78" />
      <use href={`#${leafId}`} transform="translate(940 461) rotate(-45) scale(0.9)" opacity="0.88" />

      <!-- Batu kecil di garis tanah -->
      <ellipse cx="560" cy="640" rx="54" ry="15" fill="#C4B9A9" opacity="0.45" />
      <ellipse cx="1150" cy="650" rx="34" ry="10" fill="#C4B9A9" opacity="0.35" />
    </svg>
  )}
  {image?.caption && <figcaption>{image.caption}</figcaption>}
</figure>
