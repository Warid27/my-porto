---
const projects = [
  {
    num: '01',
    name: 'Pemiyos',
    url: 'https://pemiyos.netlify.app/',
    tags: ['Web', 'Full-stack', 'Collaborative'],
    accent: '#FFE03D',
    featured: true,
    badge: 'Most Contribution',
    description: 'Full-featured collaborative web project — my most significant contribution to date. Showcases comprehensive full-stack web development skills across the entire project lifecycle.',
  },
  {
    num: '02',
    name: 'Saga Advisor',
    url: 'https://saga-advisor.vercel.app/',
    tags: ['Next.js', 'Vercel', 'Web App'],
    accent: '#3D5AFE',
    featured: false,
    description: 'Prototype professional web application built with Next.js. Clean architecture, modern UX patterns, and deployed to Vercel.',
  },
  {
    num: '03',
    name: 'LKS 2025',
    url: 'https://lks-2025-warid.vercel.app/',
    tags: ['Game', 'HTML/CSS/JS', 'Competition'],
    accent: '#FF3CA0',
    featured: false,
    description: 'Browser-based Bomb It-style game built for national vocational skills competition (LKS). Fully playable, zero dependencies, pure HTML/CSS/JS.',
  },
  {
    num: '04',
    name: 'Chailly Bot',
    url: 'https://chaillubot.vercel.app/',
    tags: ['AI', 'Next.js', 'Bot'],
    accent: '#00E676',
    featured: false,
    description: 'Interactive AI assistant bot with advanced conversational abilities and a clean, smooth interface. Built with Next.js.',
  },
  {
    num: '05',
    name: 'Crossy Road Three.js',
    url: 'https://crossy-road-threejs-next.vercel.app/',
    tags: ['3D', 'Three.js', 'Next.js', 'Game'],
    accent: '#B447FF',
    featured: false,
    description: '3D browser game recreating Crossy Road mechanics using Three.js and Next.js. Full 3D scene, collision detection, and score system.',
  },
  {
    num: '06',
    name: 'Latihan LKS',
    url: 'https://latihan-lks.vercel.app/',
    tags: ['Training', 'Next.js', 'Full-stack'],
    accent: '#FF6B2B',
    featured: false,
    description: 'Full-stack training project built as competition preparation. End-to-end implementation with modern tooling and clean codebase.',
  },
];
---
<section id="projects" class="py-20 bg-[var(--white)]" style="border-top: 3px solid var(--black);">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Pink strip header -->
    <div class="-mx-4 sm:-mx-6 lg:-mx-8 mb-10" style="background: var(--pink); border-bottom: 3px solid var(--black);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2">
        <span class="nb-section-label mb-0" style="background: var(--black); color: var(--pink);">[ FEATURED PROJECTS ]</span>
      </div>
    </div>

    <div data-aos="fade-up">
      <h2 class="font-display font-extrabold text-[44px] mb-2">Things I've actually shipped.</h2>
      <p class="text-gray-500 mb-10 font-display">Real projects. Real URLs. Click to explore them live.</p>
    </div>

    <!-- Project grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {projects.map((project, i) => (
        <div class="nb-card bg-[var(--white)] flex flex-col overflow-hidden relative" data-aos="fade-up" data-aos-delay={i * 80}>
          <!-- Accent bar -->
          <div class="w-full h-[6px]" style={`background: ${project.accent};`}></div>

          <div class="p-5 flex flex-col flex-1 relative">
            <!-- Giant faint number -->
            <span class="font-mono text-[72px] font-bold absolute top-2 right-4 select-none pointer-events-none" style="color: rgba(0,0,0,0.04);">#{project.num}</span>

            <!-- Featured badge -->
            {project.featured && (
              <span class="nb-tag absolute top-3 right-3 z-10" style="background: var(--yellow); transform: rotate(3deg);">{project.badge || 'FEATURED'}</span>
            )}

            <!-- Project name -->
            <h3 class="font-display font-extrabold text-xl mb-3 relative z-10">{project.name}</h3>

            <!-- Tags -->
            <div class="flex flex-wrap gap-1.5 mb-3">
              {project.tags.map(tag => (
                <span class="nb-tag text-[10px]" style="background: var(--yellow);">{tag}</span>
              ))}
            </div>

            <!-- Description -->
            <p class="text-sm text-gray-600 leading-relaxed mb-4 flex-1">{project.description}</p>

            <!-- Divider -->
            <div class="border-t-[2px] border-black mb-3"></div>

            <!-- Live site button -->
            <a href={project.url} target="_blank" rel="noopener" class="nb-btn text-sm py-2 px-4 bg-[var(--white)] text-black no-underline justify-center">
              Live Site ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>