---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BlogCover from '../../components/BlogCover.astro';
import blog from '../../../data/blog.json';

const posts = [...blog.posts].sort((a, b) => +new Date(b.pubDate) - +new Date(a.pubDate));
const domain = Astro.site?.toString().replace(/\/$/, '') ?? '';
const breadcrumbs = [
  { name: 'Home', url: `${domain}/` },
  { name: 'Blog', url: `${domain}/blog/` },
];
---
<Layout
  title="Blog"
  description={blog.body}
  breadcrumbs={breadcrumbs}
  bodyClass="jp-blog"
>
  <Navbar />
  <main class="pt-[clamp(6rem,12vw,9rem)] pb-[clamp(5rem,10vw,8rem)]">
    <div class="max-w-[760px] mx-auto px-6">
      <header class="mb-[clamp(3rem,6vw,4.5rem)]" data-aos="fade-up">
        <span class="jp-label">{blog.sectionLabel}</span>
        <h1 class="blog-title blog-title--page">{blog.heading}</h1>
        <p class="blog-intro">{blog.body}</p>
        <div class="blog-rule" aria-hidden="true"></div>
      </header>

      <div class="space-y-8">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}/`} class="blog-card p-6 sm:p-8" data-aos="fade-up" data-aos-delay={i * 70}>
            <BlogCover image={post.image} class="mb-7" />
            <h2 class="blog-card-title">{post.title}</h2>
            <p class="blog-card-desc">{post.description}</p>
            <div class="flex flex-wrap items-center gap-2 mt-6">
              <time class="blog-pill blog-pill--date" datetime={post.pubDate}>
                {new Date(post.pubDate).toLocaleDateString('id-ID', {
                  year: 'numeric', month: 'long', day: 'numeric'
                })}
              </time>
              {post.tags.map(tag => <span class="blog-pill">{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</Layout>
