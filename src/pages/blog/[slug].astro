---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import BlogCover from '../../components/BlogCover.astro';
import blog from '../../../data/blog.json';

export function getStaticPaths() {
  return blog.posts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const domain = Astro.site?.toString().replace(/\/$/, '') ?? '';
const breadcrumbs = [
  { name: 'Home', url: `${domain}/` },
  { name: 'Blog', url: `${domain}/blog/` },
  { name: post.title, url: `${domain}/blog/${post.slug}/` },
];
---

<Layout
  title={post.title}
  description={post.description}
  ogType="article"
  publishedTime={new Date(post.pubDate).toISOString()}
  breadcrumbs={breadcrumbs}
  bodyClass="jp-blog"
>
  <Navbar />
  <main class="pt-[clamp(6rem,12vw,9rem)] pb-[clamp(5rem,10vw,8rem)]">
    <article class="max-w-[760px] mx-auto px-6">
      <a href="/blog/" class="jp-label inline-block mb-8">← Kembali ke semua tulisan</a>

      <header class="mb-[clamp(2rem,4vw,3rem)]" data-aos="fade-up">
        <h1 class="blog-title blog-title--page">{post.title}</h1>
        <p class="blog-intro">{post.description}</p>
        <div class="flex flex-wrap items-center gap-2 mt-6">
          <time class="blog-pill blog-pill--date" datetime={post.pubDate}>
            {new Date(post.pubDate).toLocaleDateString('id-ID', {
              year: 'numeric', month: 'long', day: 'numeric'
            })}
          </time>
          {post.tags.map(tag => <span class="blog-pill">{tag}</span>)}
        </div>
        <div class="blog-rule" aria-hidden="true"></div>
      </header>

      <BlogCover image={post.image} class="mb-10" loading="eager" />

      <div class="blog-prose space-y-6" data-aos="fade-up">
        {post.content.map(paragraph => <p>{paragraph}</p>)}
      </div>
    </article>
  </main>
  <Footer />
</Layout>
