---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import Contact from '../../components/Contact.astro';
import blog from '../../../data/blog.json';

// Content schema (data/blog.json):
//   image?:   { url: string, alt?: string, caption?: string }   → hero under the title (falls back to placeholder)
//   content:  (string | { image: string, alt?: string, caption?: string })[]
interface BlogImage {
  url: string;
  alt?: string;
  caption?: string;
}

interface BlogPost {
  slug: string;
  title: string;
  description: string;
  pubDate: string;
  tags: string[];
  image?: BlogImage;
  content: (string | { image: string; alt?: string; caption?: string })[];
}

// Menghasilkan URL dinamis untuk setiap post di data/blog.json
export function getStaticPaths() {
  return blog.posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPost };
const pubDate = new Date(post.pubDate);

// Warm Japandi still life — used when a post has no hero of its own
const HERO_PLACEHOLDER: BlogImage = {
  url: 'https://coresg-normal.trae.ai/api/ide/v1/text_to_image?prompt=minimalist%20japandi%20still%20life%20photograph%2C%20handmade%20ceramic%20tea%20cup%20on%20light%20oak%20wooden%20table%2C%20linen%20napkin%2C%20dried%20grass%20stem%20in%20small%20clay%20vase%2C%20warm%20cream%20and%20beige%20color%20palette%2C%20soft%20diffused%20morning%20window%20light%2C%20gentle%20natural%20shadows%2C%20calm%20scandinavian%20japanese%20aesthetic%2C%20muted%20earthy%20tones%2C%20photorealistic%2C%20high%20detail&image_size=landscape_16_9',
  alt: 'Stil life japandi — cangkir keramik di atas meja kayu oak dengan cahaya pagi yang lembut',
};

const hero = post.image ?? HERO_PLACEHOLDER;
---
<Layout title={`${post.title} | Warid`} description={post.description} bodyClass="jp-blog">
  <Navbar />
  <main class="pt-[clamp(6rem,12vw,9rem)] pb-[clamp(4rem,8vw,6rem)]">
    <article class="max-w-[700px] mx-auto px-6">
      <header data-aos="fade-up">
        <a href="/blog/" class="blog-back">
          <span class="blog-back-arrow" aria-hidden="true">&larr;</span>
          <span>Kembali ke semua tulisan</span>
        </a>
        <h1 class="blog-title blog-title--post mt-8 mb-7">{post.title}</h1>
        <div class="flex flex-wrap items-center gap-2">
          <time class="blog-pill blog-pill--date" datetime={post.pubDate}>
            {pubDate.toLocaleDateString('id-ID', {
              year: 'numeric', month: 'long', day: 'numeric'
            })}
          </time>
          {post.tags.map(tag => <span class="blog-pill">{tag}</span>)}
        </div>
        {post.description && <p class="blog-lede mt-8">{post.description}</p>}
      </header>

      <figure class="blog-hero" data-aos="fade-up">
        <img src={hero.url} alt={hero.alt ?? ''} loading="eager" decoding="async" />
        {hero.caption && <figcaption>{hero.caption}</figcaption>}
      </figure>

      <div class="blog-prose mt-10" data-aos="fade-up" data-aos-delay="100">
        {post.content.map(block => typeof block === 'string' ? (
          <p>{block}</p>
        ) : (
          <figure class="blog-figure">
            <img src={block.image} alt={block.alt ?? ''} loading="lazy" decoding="async" />
            {block.caption && <figcaption>{block.caption}</figcaption>}
          </figure>
        ))}
      </div>

      <div class="blog-end" aria-hidden="true">&middot;&middot;&middot;</div>

      <footer class="blog-article-footer">
        <p>
          Ada tanggapan atau ingin diskusi? <a href="#contact">Hubungi saya &rarr;</a>
        </p>
      </footer>
    </article>
  </main>
  <Contact />
  <Footer />
</Layout>
